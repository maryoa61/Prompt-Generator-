# NVIDIA_API_KEY: Required for NVIDIA NIM API calls (build.nvidia.com).
# Get a free key at https://build.nvidia.com/settings/api-keys
# It looks like: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Setup:
#   1. Copy this file to a new file named ".env" in the project root.
#   2. In that NEW ".env" file, paste your real key after the "=" below.
#   3. ".env" is already git-ignored, so your key will never be committed.
#
# These two keys must stay present (even if empty) so the app always
# compiles; an empty NVIDIA_API_KEY simply makes the app use fully
# offline/local prompt generation instead of calling the NVIDIA API.
NVIDIA_API_KEY=

# NVIDIA_MODEL: (optional) override the default model used for prompt
# generation. Leave empty to use the built-in default. Browse available
# models at https://build.nvidia.com/models
NVIDIA_MODEL=

# ---------------------------------------------------------------------------
# GEMINI_API_KEY: kept for reference only, no longer used by this app.
# This project now uses NVIDIA_API_KEY above instead of Gemini/Firebase AI.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
