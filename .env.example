# GROQ_API_KEY: Required for Groq API calls (console.groq.com).
# Get a free key at https://console.groq.com/keys
# It looks like: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Setup:
#   1. Copy this file to a new file named ".env" in the project root.
#   2. In that NEW ".env" file, paste your real key after the "=" below.
#   3. ".env" is already git-ignored, so your key will never be committed.
#
# These two keys must stay present with a non-empty placeholder value
# (even if you have no real key yet) so the app always compiles; an
# invalid/placeholder GROQ_API_KEY simply makes the app use fully
# offline/local prompt generation instead of calling the Groq API.
GROQ_API_KEY=MY_GROQ_API_KEY

# GROQ_MODEL: (optional) override the default model used for prompt
# generation. Leave as the default below, or browse available models at
# https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# NVIDIA_API_KEY / GEMINI_API_KEY: kept for reference only, no longer used.
# This project now uses GROQ_API_KEY above instead.
# NVIDIA_API_KEY=MY_NVIDIA_API_KEY
# GEMINI_API_KEY=MY_GEMINI_API_KEY
